# Copy this file to .env and fill in your values
# cp .env.example .env

# IBKR Flex Query credentials
# Get these from your IBKR account portal under Reports > Flex Queries
IBKR_TOKEN=your_flex_query_token_here
IBKR_QUERY_ID=your_flex_query_id_here

# Alpha Vantage API key (optional - used as fallback for market data)
# Get a free key at https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# Contact address sent in the User-Agent when the ETF look-through feature calls OpenFIGI,
# GLEIF or an issuer's holdings endpoint (optional - omitted entirely if left unset).
# These are third-party sites used as a guest, so identifying the client is good manners.
LOOKTHROUGH_CONTACT_EMAIL=you@example.com

# Database URL (SQLite default - no changes needed for local dev)
DATABASE_URL=sqlite+aiosqlite:///./portfolio.db

# CORS origins - comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
