# Backend environment configuration — TEMPLATE.
# Copy to backend/.env and fill in real values. backend/.env is gitignored
# (it holds secrets); this .example file is the only env file committed to git.

# --- IBKR Flex Web Service (required) ---
# Token:    IBKR portal > Reports > Settings > Flex Web Service
# Query ID: IBKR portal > Reports > Flex Queries > Custom Flex Queries > Configure
IBKR_TOKEN=your_flex_query_token
IBKR_QUERY_ID=your_flex_query_id

# --- Optional ---
ALPHA_VANTAGE_API_KEY=

# Contact address sent in the User-Agent when the look-through calls OpenFIGI, GLEIF or an
# ETF issuer's holdings endpoint. Empty omits it; nothing breaks.
LOOKTHROUGH_CONTACT_EMAIL=

# Free, self-service from https://www.openfigi.com/api — no payment details, issued instantly.
# Optional: without it the look-through identity resolver still works, at 10 identifiers per
# request and 25 requests/minute. With it, 100 per request and 250 requests/minute, which is
# what makes resolving fund *constituents* (thousands of ISINs) affordable rather than just
# the couple of dozen held directly.
OPENFIGI_API_KEY=

# --- Crypto book (docs/crypto.md) ---
# CoinStats public API key, from https://openapi.coinstats.app (the free plan is enough:
# 20,000 credits/month, and the schedule spends ~5.5k). Sent as a header, never in a URL.
COIN_STATS_API_KEY=
# The token behind a CoinStats *share link* for the portfolio connected in the CoinStats app:
# coinstats.app/portfolio -> Share -> Generate Link -> the part after /p/. Anyone holding it
# can read the portfolio, so treat it like a password. Both are needed; without them the
# crypto sync does nothing and Crypto mode says it is not configured.
COIN_STATS_SHARE_TOKEN=
# Only if the share link has a 6-digit passcode.
COIN_STATS_SHARE_PASSCODE=
# CoinGecko's free Demo API key, the crypto book's price source. Sent only as a header.
# Without it the sync still stores CoinStats' snapshot, and every value it cannot price
# reads as unknown.
COINGECKO_API_KEY=

# --- Holding logos (docs/logos.md) ---
# logo.dev's SECRET key (sk_...), from the logo.dev dashboard; the free plan's monthly credits
# cover the logo pass. Server-side only, sent as a Bearer header. Without it the logo pass is
# skipped and every holding keeps its monogram.
LOGO_DEV_SECRET_KEY=

# --- Database ---
# SQLite file, for local development. In Docker this line is IGNORED: docker-compose.yml
# sets DATABASE_URL to /app/data/portfolio.db (backend/data/ on the host, a directory
# bind mount) and `environment:` overrides this file.
DATABASE_URL=sqlite+aiosqlite:///./portfolio.db

# --- CORS (comma-separated allowed origins) ---
# Include the production domain plus any local dev origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,https://portfolio.srv1211053.hstgr.cloud

# --- Write authentication (app/auth.py) ---
# Shared secret required on POST/PUT/PATCH/DELETE under /api/. nginx proxies /api/
# publicly, so without this anyone who can reach the site can change the base currency,
# edit the watchlist, or start syncs that spend the IBKR Flex and Yahoo rate limits.
#
# LEAVING IT UNSET DISABLES THE CHECK — that is the default so an existing deployment
# keeps working, and startup logs a warning while it is off. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# then paste the same value into the app's lock button (header, beside Sync).
# Crypto mode needs it too: /api/crypto reads are private and refuse outright without it.
# API_ADMIN_TOKEN=

# --- Rate limiting (app/rate_limit.py) ---
# Requests per minute per client IP across /api/. One dashboard load issues a dozen or
# so, so the default is generous; 0 disables it.
# RATE_LIMIT_PER_MINUTE=120
# Proxies in front of the backend that append to X-Forwarded-For (the host nginx = 1).
# The client is the entry that many places from the right; 0 keys on the peer address.
# TRUSTED_PROXY_HOPS=1

# --- Build identity ---
# Reported by /health and shown in the app footer, so a deploy can be confirmed from a
# browser. deploy.sh and ops/auto-deploy.sh set GIT_COMMIT from the deployed sha.
# GIT_COMMIT=
# APP_VERSION=1.0.0

# --- Logging ---
# LOG_LEVEL=INFO

# --- Scheduler ---
# Arms every scheduled Europe/Berlin job (the hours are ALL_SYNC_HOURS in
# app/services/scheduler_service.py — deliberately not copied here). Those jobs call
# the live IBKR Flex API and Yahoo Finance, both rate-limited, and the Flex token
# locks out for hours on repeated failures. Leave unset (defaults to true) in
# production; set false for any local run so uvicorn doesn't quietly start syncing
# against real APIs.
# SCHEDULER_ENABLED=false

# Where APScheduler persists its jobs: a separate SQLite file from portfolio.db, inside
# the directory docker-compose bind-mounts. The default is right for both local and Docker.
# SCHEDULER_JOBSTORE_URL=sqlite:///./scheduler-data/scheduler_jobs.db
