# Backend environment configuration — TEMPLATE.
# Copy to backend/.env and fill in real values. backend/.env is gitignored
# (it holds secrets); this .example file is the only env file committed to git.

# --- IBKR Flex Web Service (required) ---
# Token:    IBKR portal > Reports > Settings > Flex Web Service
# Query ID: IBKR portal > Reports > Flex Queries > Custom Flex Queries > Configure
IBKR_TOKEN=your_flex_query_token
IBKR_QUERY_ID=your_flex_query_id

# --- Optional ---
ALPHA_VANTAGE_API_KEY=

# Free, self-service from https://www.openfigi.com/api — no payment details, issued instantly.
# Optional: without it the look-through identity resolver still works, at 10 identifiers per
# request and 25 requests/minute. With it, 100 per request and 250 requests/minute, which is
# what makes resolving fund *constituents* (thousands of ISINs) affordable rather than just
# the couple of dozen held directly.
OPENFIGI_API_KEY=

# --- Database ---
# SQLite file; persisted on the host via the docker bind mount in docker-compose.yml.
DATABASE_URL=sqlite+aiosqlite:///./portfolio.db

# --- CORS (comma-separated allowed origins) ---
# Include the production domain plus any local dev origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,https://portfolio.srv1211053.hstgr.cloud

# --- Write authentication (app/auth.py) ---
# Shared secret required on POST/PUT/PATCH/DELETE under /api/. nginx proxies /api/
# publicly, so without this anyone who can reach the site can change the base currency,
# edit the watchlist, or start syncs that spend the IBKR Flex and Yahoo rate limits.
#
# LEAVING IT UNSET DISABLES THE CHECK — that is the default so an existing deployment
# keeps working, and startup logs a warning while it is off. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# then paste the same value into the app's lock button (header, beside Sync).
# API_ADMIN_TOKEN=

# --- Rate limiting (app/rate_limit.py) ---
# Requests per minute per client IP across /api/. One dashboard load issues a dozen or
# so, so the default is generous; 0 disables it.
# RATE_LIMIT_PER_MINUTE=120

# --- Build identity ---
# Reported by /health and shown in the app footer, so a deploy can be confirmed from a
# browser. deploy.sh and ops/auto-deploy.sh set GIT_COMMIT from the deployed sha.
# GIT_COMMIT=
# APP_VERSION=1.0.0

# --- Scheduler ---
# Arms the daily 08:00/13:00/15:00/20:00/22:00 Europe/Berlin sync jobs. Those
# jobs call the live IBKR Flex API and Yahoo Finance, both rate-limited, and the
# Flex token locks out for hours on repeated failures. Leave unset (defaults to
# true) in production; set false for any local run so uvicorn doesn't quietly
# start syncing against real APIs.
# SCHEDULER_ENABLED=false
