# The host nginx vhost, as live on the VPS: /etc/nginx/sites-available/portfolio, linked into
# sites-enabled/. Copied from the server on 2026-10-18 (GitHub issue #51); nothing installs
# it, so after editing the live file copy it back here, and the reverse on a rebuilt VPS
# (docs/deployment.md, The host nginx vhost). Lines marked "managed by Certbot" are
# Certbot's: it wrote the 443 server's TLS block and the whole port-80 server.
#
# - TLS terminates here; compose publishes the backend on 127.0.0.1:8000 and the frontend
#   container on 127.0.0.1:8080, whose frontend-nginx.conf sets the CSP and cache headers.
# - Every listen has its [::] twin: an AAAA record exists (the 2026-07-08 incident).
# - /etc/nginx/proxy_params (Debian's) sets Host, X-Real-IP, X-Forwarded-Proto and
#   X-Forwarded-For $proxy_add_x_forwarded_for — the rightmost entry app/rate_limit.py keys
#   on (TRUSTED_PROXY_HOPS=1), so whatever a client puts in the header itself is ignored.
# - proxy_read_timeout 300: a Flex sync or a market-data pass can hold a request for minutes.
# The same nginx serves an unrelated n8n vhost: edit this server's file only, and reload with
# `nginx -t && systemctl reload nginx`.
server {
    server_name portfolio.srv1211053.hstgr.cloud;
    client_max_body_size 20m;

    # HSTS: the OWNER's call, deliberately commented out (STATUS.md, Needs a human). The
    # header is sticky in every browser that sees it, so start with a short max-age (5
    # minutes here), confirm nothing breaks, then raise it. Never add includeSubDomains:
    # the n8n vhost and the rest of hstgr.cloud are not this site's to commit.
    # add_header Strict-Transport-Security "max-age=300" always;

    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        include /etc/nginx/proxy_params;
        proxy_read_timeout 300;
    }

    location = /health {
        proxy_pass http://127.0.0.1:8000;
        include /etc/nginx/proxy_params;
    }

    location / {
        proxy_pass http://127.0.0.1:8080;
        include /etc/nginx/proxy_params;
    }

    listen 443 ssl;
    listen [::]:443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/portfolio.srv1211053.hstgr.cloud/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/portfolio.srv1211053.hstgr.cloud/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}
server {
    if ($host = portfolio.srv1211053.hstgr.cloud) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    server_name portfolio.srv1211053.hstgr.cloud;

    listen 80;
    listen [::]:80;
    return 404; # managed by Certbot


}
